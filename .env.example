# ===================================================
# OpenAI / OpenRouter / Custom Compatible Provider
# ===================================================
# Jika menggunakan OpenRouter:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1-xxxxxxxx
#
# Jika menggunakan OpenAI Asli:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-proj-xxxxxxxx

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_api_key_here

# Model Selection (Bisa menggunakan ID OpenRouter seperti anthropic/claude-3.5-sonnet, openai/gpt-4o, deepseek/deepseek-chat, atau gpt-4o-mini)
DIRECTOR_MODEL=gpt-4o-mini
CODER_MODEL=gpt-4o

# ===================================================
# Audio & TTS Settings (Default: msedge-tts GRATIS tanpa API Key)
# ===================================================
TTS_PROVIDER=msedge-tts
TTS_VOICE_ID=id-ID-ArdiNeural

# Gemini TTS via 9router. Voice can be changed per video on the draft screen.
# TTS_PROVIDER=9router
# TTS_MODEL=gemini/gemini-2.5-flash-preview-tts
# TTS_VOICE_ID=Charon

# 9router (OpenAI-compatible speech endpoint). Base URL includes /v1.
# TTS_PROVIDER=9router
# TTS_BASE_URL=http://your-9router-host:20128/v1
# TTS_API_KEY=your_9router_key
# TTS_MODEL=edge-tts/id-ID-ArdiNeural
# TTS_BASE_URL / TTS_API_KEY default to OPENAI_BASE_URL / OPENAI_API_KEY.

# Opsional: suara ElevenLabs sebagai pilihan berbayar di layar draf (1 kredit tambahan).
# Kunci butuh izin text_to_speech. Izin voices_read membuat daftar suara akun muncul.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Kosong berarti eleven_v4.
ELEVENLABS_MODEL=

# =
# Akun dan pembayaran
# =
# Alamat publik aplikasi, dipakai untuk redirect Google. Lokal: http://localhost:3100
APP_URL=

# Google Cloud Console > APIs & Services > Credentials (OAuth client: Web application).
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Xendit Dashboard. Kunci uji diawali xnd_development_ dan memunculkan tombol simulasi.
XENDIT_SECRET_KEY=
# Dashboard > Webhooks: verification token, dan URL <APP_URL>/api/webhooks/xendit
XENDIT_WEBHOOK_TOKEN=

# Cloudflare D1 lewat REST API. Jika kosong saat dev, dipakai storage/gmotion.db.
# Wajib diisi di production. Token perlu izin D1 Edit.
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Email admin yang boleh membuka /admin/biaya, dipisah koma. Kosong berarti tidak ada admin.
ADMIN_EMAILS=

# Email akun yang boleh membuka project lama yang belum punya pemilik.
LEGACY_PROJECT_OWNER_EMAIL=

# Notifikasi email proyek. Isi APP_URL dengan alamat publik Studio.
# Biarkan host dan pengirim kosong sampai SMTP siap.
SMTP_HOST=
# 587 untuk STARTTLS, 465 untuk TLS langsung.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

PORT=3000
